# Copy this file to .env and fill in your keys. Never commit .env.

# Google Gemini (primary LLM)
API_KEY=replace_with_google_gemini_api_key
# You can also use GEMINI_API_KEY or GOOGLE_API_KEY.
INFJ_PRIMARY_MODEL=gemini-2.5-flash
INFJ_CRITIC_MODEL=gemini-2.5-flash

# Anthropic / Claude (optional — used when Claude model is selected)
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
# ANTHROPIC_ORG_ID is sensitive — treat it like a secret.
ANTHROPIC_ORG_ID=replace_with_org_id
CLAUDE_MODEL=claude-sonnet-4-20250514

# Reflection and runtime
REFLECTION_INTERVAL=10

# Security: comma-separated list of domains the bughunter tools are pre-authorized to scan
INFJ_AUTHORIZED_TARGETS=

# Local LLM fallback via Ollama
INFJ_LOCAL_MODEL=qwen3:4b
INFJ_USE_LOCAL_FALLBACK=true
OLLAMA_HOST=http://localhost:11434
