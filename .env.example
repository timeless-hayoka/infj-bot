# INFJ Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API Keys (at least one required for cloud models) ─────────────
# Google Gemini (primary provider)
API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# Or store the raw key on disk (first non-comment line); path under home recommended:
# API_KEY_FILE=/home/you/.secrets/gemini_api_key.txt

# Anthropic / Claude (optional)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_ORG_ID=your_org_id
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Data & Persistence ────────────────────────────────────────────
# Set to an external drive for portable state (SQLite, Chroma, logs).
# Must be under your home directory or the project root.
# INFJ_DATA_DIR=/media/crexs/PortableSSD/drift-data

# ── Model Configuration ───────────────────────────────────────────
INFJ_PRIMARY_MODEL=gemini-2.5-flash
INFJ_CRITIC_MODEL=gemini-2.5-flash

# ── Groq High-Speed Inference ─────────────────────────────────────
# GROQ_API_KEY=your_groq_key_here
# DRIFT_GROQ_MODEL=llama-3.3-70b-versatile
# DRIFT_USE_GROQ=true

# ── Moonshot Kimi Inference ───────────────────────────────────────
# KIMI_API_KEY=your_kimi_key_here
# DRIFT_KIMI_MODEL=moonshot-v1-8k
# DRIFT_USE_KIMI=false
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── Bugcrowd API (bug bounty module) ──────────────────────────────
# BUGCROWD_API_KEY=your_bugcrowd_key_here

# ── Local LLM Fallback (Ollama) ───────────────────────────────────
INFJ_LOCAL_MODEL=qwen3:4b
INFJ_USE_LOCAL_FALLBACK=true
OLLAMA_HOST=http://localhost:11434

# ── Prompt Budgets ────────────────────────────────────────────────
# Approximate English chars per token (4 is conservative)
INFJ_CHARS_PER_TOKEN=4
INFJ_MAX_TOTAL_PROMPT_CHARS=12000
INFJ_MEMORY_SEARCH_TOP_K=8
INFJ_DOCUMENT_CHUNK_CHARS=800
INFJ_DOCUMENT_CHUNK_OVERLAP=100

# ── Reflection & Scheduler ────────────────────────────────────────
# How many interactions between automatic reflection cycles
REFLECTION_INTERVAL=10

# ── Security ──────────────────────────────────────────────────────
# Comma-separated list of domains the bughunter tools may scan
INFJ_AUTHORIZED_TARGETS=example.com,localhost

# ── Identity Vault (core/svalbard_vault.py) ───────────────────────
# Override path for the append-only, hash-chained identity ledger.
# Defaults to <DATA_ROOT>/svalbard_ledger.jsonl (or ~/.drift_os/svalbard_ledger.jsonl
# as a final fallback). The HMAC signature file lives next to it as <path>.sig.
# DRIFT_VAULT_PATH=/path/to/svalbard_ledger.jsonl
#
# HMAC-SHA256 secret used to sign the latest ledger hash. Treat as a credential.
# If unset, the vault prints a warning and uses an insecure default — do not
# leave that in place for any deployment that matters. Back up this value
# separately from the ledger file; losing it breaks integrity verification.
# DRIFT_VAULT_SECRET=replace_with_a_long_random_string

# ── Email (optional) ──────────────────────────────────────────────
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# Or use Gmail MCP OAuth (see scripts/gmail_mcp_auth.py)

# ── Logging ───────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR
# INFJ_LOG_LEVEL=INFO
