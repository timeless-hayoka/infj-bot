#!/usr/bin/env python3
"""DRIFT Hive Mind — Master Launcher

Usage:
    ./hive init              # Initialize the hive
    ./hive start             # Start orchestrator + observatory
    ./hive status            # Show hive status
    ./hive demo              # Run consensus demo
    ./hive stop              # Stop all hive processes
    ./hive observatory       # Start observatory dashboard only
    ./hive sync              # Force memory sync
    ./hive test              # Run all tests

This is the single command that unifies all AI instances
into one distributed mind.
"""
from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

PID_DIR = Path("/tmp/drift_hive/pids")
PID_DIR.mkdir(parents=True, exist_ok=True)

ORCH_PID = PID_DIR / "orchestrator.pid"
OBS_PID = PID_DIR / "observatory.pid"


def run_init():
    print("[hive] Initializing DRIFT Hive Mind...")
    from orchestrator import HiveOrchestrator
    orch = HiveOrchestrator()
    orch.init_hive()
    print("[hive] Hive initialized. Run './hive start' to begin.")


def run_start():
    print("[hive] Starting DRIFT Hive Mind...")
    # Start orchestrator in background
    orch_proc = subprocess.Popen(
        [sys.executable, "-c",
         "import sys; sys.path.insert(0, '.'); from orchestrator import HiveOrchestrator, main; o=HiveOrchestrator(); o.init_hive(); o.start(); import time; [time.sleep(1) for _ in iter(int, 1)]"],
        cwd=str(Path(__file__).resolve().parent),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    ORCH_PID.write_text(str(orch_proc.pid))
    print(f"[hive] Orchestrator started (PID {orch_proc.pid})")

    # Start observatory in background
    obs_proc = subprocess.Popen(
        [sys.executable, "observatory/server.py"],
        cwd=str(Path(__file__).resolve().parent),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    OBS_PID.write_text(str(obs_proc.pid))
    print(f"[hive] Observatory started (PID {obs_proc.pid})")

    time.sleep(1)
    print("[hive] Hive is live.")
    print("[hive] Dashboard: http://127.0.0.1:8766")
    print("[hive] Use './hive status' to check health.")


def run_stop():
    print("[hive] Stopping DRIFT Hive Mind...")
    for pid_file in [ORCH_PID, OBS_PID]:
        if pid_file.exists():
            try:
                pid = int(pid_file.read_text().strip())
                os.kill(pid, signal.SIGTERM)
                print(f"[hive] Stopped process {pid}")
            except ProcessLookupError:
                print(f"[hive] Process {pid} already gone")
            except Exception as e:
                print(f"[hive] Error stopping {pid_file.name}: {e}")
            pid_file.unlink(missing_ok=True)
    print("[hive] All processes stopped.")


def run_status():
    from orchestrator import HiveOrchestrator
    orch = HiveOrchestrator()
    status = orch.status()
    print(json.dumps(status, indent=2, default=str))


def run_demo():
    from orchestrator import HiveOrchestrator
    orch = HiveOrchestrator()
    orch.init_hive()
    orch.start()
    time.sleep(0.5)
    orch.run_consensus_demo()
    orch.stop()


def run_observatory():
    print("[hive] Starting Observatory only...")
    from observatory.server import ObservatoryServer
    server = ObservatoryServer()
    try:
        import asyncio
        asyncio.run(server.run())
    except KeyboardInterrupt:
        print("\n[Observatory] Stopped.")


def run_sync():
    from orchestrator import HiveOrchestrator
    orch = HiveOrchestrator()
    result = orch.force_sync()
    print(json.dumps(result, indent=2))


def run_test():
    import subprocess
    test_dir = Path(__file__).resolve().parent / "tests"
    tests = list(test_dir.glob("test_*.py"))
    print(f"[hive] Running {len(tests)} test suites...")
    passed = 0
    failed = 0
    for test in tests:
        print(f"\n[test] {test.name}")
        result = subprocess.run([sys.executable, str(test)], capture_output=True, text=True)
        if result.returncode == 0:
            print(result.stdout)
            passed += 1
        else:
            print(result.stdout)
            print(result.stderr)
            failed += 1
    print(f"\n[hive] Results: {passed} passed, {failed} failed")


def main():
    parser = argparse.ArgumentParser(description="DRIFT Hive Mind Master Launcher")
    parser.add_argument("command", choices=["init", "start", "stop", "status", "demo", "observatory", "sync", "test"])
    args = parser.parse_args()

    os.chdir(Path(__file__).resolve().parent)

    commands = {
        "init": run_init,
        "start": run_start,
        "stop": run_stop,
        "status": run_status,
        "demo": run_demo,
        "observatory": run_observatory,
        "sync": run_sync,
        "test": run_test,
    }
    commands[args.command]()


if __name__ == "__main__":
    main()
