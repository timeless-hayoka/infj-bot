#!/usr/bin/env bash
# ANCHOR / DRIFT CLI launcher — always uses the package entrypoint, not legacy cli.py.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR"

export PYTHONPATH="${PROJECT_DIR}${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONNOUSERSITE=1

VENV_PY="$PROJECT_DIR/.venv/bin/python"
if [[ -x "$VENV_PY" ]]; then
  exec "$VENV_PY" -m drift.interfaces.cli "$@"
fi

exec python3 -m drift.interfaces.cli "$@"
